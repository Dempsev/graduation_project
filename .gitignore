# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak
*.orig
*.asv
*~

# Python
__pycache__/
.pytest_cache/
*.pyc

# MATLAB / COMSOL transient files
*.mph.lock

# Generated research artifacts
# All simulation outputs, training tables, manifests, plots, and checkpoints
# are written under data/ and should not be committed.
data/
web/
tmp/
tmp_ppt_rebuild/
tmp_ppt_render/
output/
.worktrees/

# Chapter evidence source files live under research_validation/. Generated
# tables, rendered figures, local checklists, and export notes are reproducible
# from the tracked scripts and public wrappers.
research_validation/**/*.csv
research_validation/**/*.png
research_validation/**/*.svg
research_validation/**/*.pdf
research_validation/**/*.txt
research_validation/**/*.json

# Thesis drafts, slides, translated papers, and exported reports belong in
# ignored artifact folders rather than the repository root.
*.doc
*.docx
*.pdf
*.ppt
*.pptx

# Legacy snake runtime logs
snake/__pycache__/
snake/logs/
snake/logs/**

# Archives
*.zip
*.7z
